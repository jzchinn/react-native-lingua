EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_PROJECT_TOKEN=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_HOST=https://us.i.posthog.com

# Stream (getstream.io) - used server-side only by app/api/stream/*+api.ts
# routes. Never prefix these with EXPO_PUBLIC_ - the app secret must never
# ship in the client bundle.
STREAM_API_KEY=xxxxxxxxxxxx
STREAM_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vision Agent (Python AI teacher service, see vision-agent/) - used
# server-side only by app/api/agent/*+api.ts to proxy start/stop requests.
# VISION_AGENT_URL is where `uv run agent.py serve` is listening (defaults
# to http://127.0.0.1:8000 locally). VISION_AGENT_SHARED_SECRET is reused by
# vision-agent/agent.py from this same file to authenticate these routes to
# that server - keep both projects' copies of this file in sync.
VISION_AGENT_URL=http://127.0.0.1:8000
VISION_AGENT_SHARED_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
