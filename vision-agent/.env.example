# STREAM_API_KEY, STREAM_API_SECRET, and VISION_AGENT_SHARED_SECRET are NOT
# set here - agent.py loads them straight from the parent Expo app's .env
# (../.env), so there is a single source of truth for the Stream
# credentials and the secret that authenticates app/api/agent/*+api.ts to
# this server's `serve` mode. `serve` mode rejects every request when that
# secret isn't set, unless you opt in explicitly with
# VISION_AGENT_INSECURE_DEV=true below (local development only).
# VISION_AGENT_INSECURE_DEV=true

# OpenAI Realtime API key, used for the AI teacher's voice.
OPENAI_API_KEY=
